# Frontend API Base URL configuration
#
# All API requests resolve against this base URL. It is used EXCLUSIVELY from
# VITE_API_BASE_URL — the client never hardcodes a fallback such as
# http://localhost:8000. If this is left unset, the app runs in DEMO mode
# (synthetic data) instead of failing with a network error.
#
# Local development against a locally-running FastAPI backend:
# VITE_API_BASE_URL=http://localhost:8000
#
# Production (set this at build time on Vercel / your host):
VITE_API_BASE_URL=https://signal-app-zxbr.onrender.com
